AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change-me
AIRFLOW_POSTGRES_DB=airflow

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_SECRET_KEY=local-dev-airflow-secret-key-change-me
AIRFLOW_WEBSERVER_HOST_PORT=8081

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=RawData
APP_MYSQL_USER=spark
APP_MYSQL_PASSWORD=change-me
SPARK_MYSQL_USER=spark
SPARK_MYSQL_PASSWORD=change-me

RAW_DATA_CSV=/app/RawData.csv
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
MAX_STREAM_BATCH_SIZE=10000
MAX_STREAM_NUM_BATCHES=1000
MAX_STREAM_INTERVAL_SECONDS=3600

MLFLOW_HOST_PORT=5002
SERVING_HOST_PORT=5003
SERVING_SPARK_DRIVER_MEMORY=2g
MLFLOW_EXPERIMENT_NAME=customer_churn
MLFLOW_REGISTERED_MODEL_NAME=customer_churn_random_forest
MODEL_PROMOTION_STAGE=Production
MIN_MODEL_AUC=0.65
MIN_PROMOTION_PREDICTION_ROWS=1
# 0.0 disables; set e.g. 0.4 to require minimum precision in the highest-risk decile
MIN_PRECISION_AT_TOP_DECILE=0.0
MODEL_TRAINING_MAX_ROWS=250000
MODEL_CV_FOLDS=2
SPARK_SQL_SHUFFLE_PARTITIONS=4
MODEL_PREDICTIONS_WRITE_MODE=append
PIPELINE_SCHEDULE=0 2 * * 0

# Drift alerting — alert fires when mean roc_auc < threshold
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DRIFT_ALERT_MIN_ROC_AUC=0.6
# Set to true to automatically trigger a new DAG run when drift is detected
AUTO_RETRAIN_ON_DRIFT=false

# Shadow deployment — challenger model runs silently alongside Production
SHADOW_MODEL_ENABLED=false
SHADOW_MODEL_STAGE=Staging

# A/B testing — route a fraction of real traffic to the challenger model
# Requires a model in SHADOW_MODEL_STAGE (Staging by default)
AB_TESTING_ENABLED=false
AB_TRAFFIC_SPLIT=0.1

# A/B outcome tracking — controls prediction logging and analysis thresholds
PREDICTION_LOGGING_ENABLED=true
# Minimum settled predictions per variant before a recommendation is issued
AB_MIN_SAMPLE_SIZE=200
AB_LIFT_ALERT_THRESHOLD=0.02
# Two-proportion z-test alpha; both significance AND lift must be met for a recommendation
AB_SIGNIFICANCE_ALPHA=0.05
# Days a prediction must age before its churn label is considered settled
LABEL_DELAY_DAYS=30
# URL of the serving container for automatic reload after rollback
# SERVING_RELOAD_URL=http://model-serving:8000/model/reload

# Kafka streaming — topic the Flask producer publishes to and Spark consumer reads from
KAFKA_CDR_TOPIC=cdr-events
# Spark Structured Streaming micro-batch interval in seconds
SPARK_STREAMING_TRIGGER_SECONDS=30
# Driver memory for the long-running spark-streaming container
STREAMING_SPARK_DRIVER_MEMORY=1g

# Data quality gates — pipeline halts if violated
MIN_RAW_ROWS=1000
DATA_MAX_STALENESS_DAYS=7

# Observability — start with: docker compose --profile observability up -d
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me
